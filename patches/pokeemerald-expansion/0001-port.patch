+void cgb_set_envelope(u8 channel, u8 envelope){
+    if(channel == 2){
+        switch((envelope & 0xE0)){
+            case 0x00:  // mute
+                gb.Vol[2] = gb.VolI[2] = 0;
+            break;
+            case 0x20:  // full
+                gb.Vol[2] = gb.VolI[2] = 4;
+            break;
+            case 0x40:  // half
+                gb.Vol[2] = gb.VolI[2] = 2;
