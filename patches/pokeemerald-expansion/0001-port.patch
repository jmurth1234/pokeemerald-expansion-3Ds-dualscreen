+#define applyBGVerticalMosaicEffect(y) (y - (y % (mosaicBGEffectY+1)))
+#define applySpriteHorizontalMosaicEffect(x) (x - (x % (mosaicSpriteEffectX+1)))
+#define applySpriteVerticalMosaicEffect(y) (y - (y % (mosaicSpriteEffectY+1)))
