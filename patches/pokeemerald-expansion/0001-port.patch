+static u16 GetCameraConnectionBlockAt(int x, int y)
+{
+    const struct MapConnections *connections = gMapHeader.connections;
+    int i;
+
+    if (connections != NULL)
+    {
+        for (i = 0; i < connections->count; i++)
+        {
+            const struct MapConnection *connection = &connections->connections[i];
+            const struct MapHeader *header = GetMapHeaderFromConnection(connection);
+            const struct MapLayout *layout;
+            int mapX = x - MAP_OFFSET;
+            int mapY = y - MAP_OFFSET;
+
+            if (header == NULL)
+                continue;
+            layout = header->mapLayout;
+            switch (connection->direction)
+            {
+            case CONNECTION_NORTH:
+                mapX -= connection->offset;
+                mapY += layout->height;
+                break;
+            case CONNECTION_SOUTH:
+                mapX -= connection->offset;
+                mapY -= gMapHeader.mapLayout->height;
+                break;
+            case CONNECTION_WEST:
+                mapX += layout->width;
+                mapY -= connection->offset;
+                break;
+            case CONNECTION_EAST:
+                mapX -= gMapHeader.mapLayout->width;
+                mapY -= connection->offset;
+                break;
+            default:
+                continue;
+            }
+
+            if (mapX >= 0 && mapX < layout->width && mapY >= 0 && mapY < layout->height)
+            {
+                const u16 *map = Port_ResolveAssetPointer(layout->map);
+                return map[mapY * layout->width + mapX];
+            }
+        }
+    }
+    return GetBorderBlockAt(x, y);
+}
