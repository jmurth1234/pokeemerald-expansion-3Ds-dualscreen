+#define VERIFY_PTR(x) do; while (0)
+#else
+#define VERIFY_PTR(x) do {\
+    uintptr_t y = (uintptr_t)(x);\
+    if (y < EWRAM_START && (y < (uintptr_t)&gMPlayJumpTableTemplate || y >= 0x40000)) {\
+        ret = 0;\
